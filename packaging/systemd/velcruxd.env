# /etc/velcrux/velcruxd.env
# Environment overrides and secret references for velcruxd server daemon
# (docs/REQUIREMENTS.md §78 "Configuration Security")

# Network Listen Bindings
VELCRUX_LISTEN_ADDR=0.0.0.0:7443
VELCRUX_METRICS_ADDR=127.0.0.1:9443

# TLS and Authentication Secrets
VELCRUX_TLS_CERT=/etc/velcrux/certs/server.crt
VELCRUX_TLS_KEY=/etc/velcrux/certs/server.key
VELCRUX_CLIENT_CA=/etc/velcrux/certs/ca.crt

# Storage Paths
VELCRUX_STORAGE_ROOT=/data/velcrux/files
VELCRUX_STORAGE_STAGING=/data/velcrux/files/.velcrux-staging
VELCRUX_STORAGE_CHUNKS=/data/velcrux/chunks
VELCRUX_STATE_DB=/var/lib/velcrux/state.db

# Operational Limits and Concurrency
VELCRUX_MAX_CONCURRENT_TRANSFERS=64
VELCRUX_DEFAULT_TRANSFER_RATE_LIMIT=0
VELCRUX_LOG_LEVEL=info
VELCRUX_LOG_FORMAT=text
